# ---- Server ----
NODE_ENV=development
PORT=5000
# Set to 1 when running behind nginx / a cloud load balancer so rate limiting sees the real client IP
TRUST_PROXY=0
# Serve the bundled chat UI from /public
SERVE_FRONTEND=true

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/brightech_bot

# ---- Security ----
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Signed file links (images/PDFs in chat) stay valid this long
FILE_URL_TTL_SECONDS=3600
# Comma-separated list of allowed browser origins (use your real front-end URL in production)
CORS_ORIGINS=http://localhost:5000,http://localhost:3000
# Needed for POST /api/auth/register-admin (send as X-Setup-Key). Leave empty to disable that endpoint.
ADMIN_SETUP_KEY=
# Optional: "npm run seed" creates this admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Date & time ----
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_TIME_FORMAT=12h
BOOKING_MAX_DAYS_AHEAD=90

# ---- Bot ----
DEFAULT_BOT_SLUG=brightech
# Reference numbers look like BT-PRD-1411-001 (final format is "To be confirmed" by the client)
REFERENCE_PREFIX=BT

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=10

# ---- Rate limits ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_MAX=30

# ---- WhatsApp via MSG91 (optional - leave MSG91_ENABLED=false to run the web chat only) ----
MSG91_ENABLED=false
# MSG91 panel -> API / Authkey. NEVER commit this. Also whitelist your server IP in MSG91 (new keys have IP security ON).
MSG91_AUTH_KEY=
# Your integrated WhatsApp number: digits with country code, no "+"  (e.g. 919XXXXXXXXX)
MSG91_INTEGRATED_NUMBER=
# Random string (16+ chars). Put it in the webhook URL you give MSG91:  .../api/webhooks/msg91?secret=THIS_VALUE
MSG91_WEBHOOK_SECRET=
# true = list/button messages. If MSG91 rejects them the bot automatically sends numbered text menus instead.
MSG91_INTERACTIVE=true
# true = print outgoing messages instead of sending (safe local testing, no key needed)
MSG91_DRY_RUN=false
# true = print every raw inbound webhook body (use this once to check MSG91's real payload format)
MSG91_LOG_RAW=false
# Hosts the bot may download customer photos/documents from (comma-separated). Add the host you see in the logs if needed.
MSG91_MEDIA_HOSTS=files.msg91.com,msg91.com
MSG91_BASE_URL=https://control.msg91.com
MSG91_SEND_PATH=/api/v5/whatsapp/whatsapp-outbound-message/
MSG91_SEND_GAP_MS=300
